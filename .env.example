# ============================================================
# Supabase 配置（复制为 .env 并填入你的真实值）
# 在 Supabase 控制台 -> Project Settings -> API Keys 中获取
# Publishable key 为新版推荐（sb_publishable_...），anon key 为兼容旧版
# ============================================================

# Project URL，例如 https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Publishable key（客户端使用，推荐）
VITE_SUPABASE_PUBLISHABLE_KEY=

# 兼容旧版：anon key（VITE_SUPABASE_ANON_KEY），与上面二选一，优先读取 PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=
