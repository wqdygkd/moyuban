############
# 摸鱼办自托管 Supabase（裁剪版）环境变量
#
# 使用方法：
#   cp .env.example .env
#   sh generate-keys.sh --update-env   # 生成全部密钥并写回 .env
# 然后只需手动修改下方「需要人工填写」的部分。
#
# 官方文档：
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
############

# ===== 密钥（由 generate-keys.sh 自动生成，不要用默认值） =====

# Postgres 数据库密码
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# 传统对称 HS256 密钥（至少 32 字符）
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# API Key（HS256 签名的 JWT），generate-keys.sh 自动生成
ANON_KEY=replace-me
SERVICE_ROLE_KEY=replace-me

# Studio 控制台的登录账号密码（公网可访问，务必改强密码）
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Studio 与 postgres-meta 之间加密连接串用的密钥（至少 32 字符）
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# ===== 需要人工填写的部分 =====

# 对外访问地址：浏览器 / 前端实际访问 Supabase 的入口（Kong 网关）
# 直连服务器时填 http://<服务器IP>:8000
# 配了反向代理/域名后改成 https://supabase.example.com
SUPABASE_PUBLIC_URL=http://localhost:8000

# Auth 服务对外地址，邮箱链接、OAuth 回调会用到
# 与 SUPABASE_PUBLIC_URL 保持同一域名，固定以 /auth/v1 结尾
API_EXTERNAL_URL=http://localhost:8000/auth/v1

# 摸鱼办前端站点的地址（GoTrue 的 Site URL，登录跳转的目标站点）
SITE_URL=http://localhost:3000

# 额外允许的跳转白名单（逗号分隔），前端在多个域名时可补充
ADDITIONAL_REDIRECT_URLS=

# Kong 网关监听的宿主机端口
API_GW_HTTP_PORT=8000

# ===== 数据库 =====

POSTGRES_HOST=db
POSTGRES_DB=postgres
# Postgres 在容器内部使用的端口
POSTGRES_PORT=5432

# ===== Auth（GoTrue）=====

# JWT 有效期（秒）
JWT_EXPIRY=3600

# 摸鱼办只有管理员维护内容：建议改为 true 关闭自助注册，
# 管理员账号由 Studio 的 Authentication -> Users 手动创建
DISABLE_SIGNUP=true

# 邮箱注册与自动确认：
# 管理员在 Studio 手动建号时勾选 Auto Confirm 即可，无需邮件
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# 邮件模板路径（保持默认即可）
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# SMTP：仅当需要「邮箱验证 / 找回密码 / 邀请注册」时才配置
# 留空则不发邮件，不影响邮箱+密码登录和手动建号
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

# ===== PostgREST / Studio =====

# 通过 REST API 暴露的 schema
PGRST_DB_SCHEMAS=public,graphql_public
# 单次请求最大返回行数
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# 选填：配置后 Studio 内置 AI 助手可用
OPENAI_API_KEY=
